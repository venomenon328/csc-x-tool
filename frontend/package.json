{
  "name": "csc-x-tool-frontend",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.20.0",
    "npm": "12.0.2"
  },
  "scripts": {
    "dev": "node scripts/run-limited.mjs vite",
    "build": "node scripts/run-limited.mjs tsc -b && node scripts/run-limited.mjs vite build",
    "lint": "node scripts/run-limited.mjs eslint .",
    "typecheck": "node scripts/run-limited.mjs tsc -b --pretty false",
    "test": "node scripts/run-limited.mjs vitest run --pool=forks --maxWorkers=1 --no-file-parallelism --maxConcurrency=1",
    "test:watch": "node scripts/run-limited.mjs vitest --pool=forks --maxWorkers=1 --no-file-parallelism --maxConcurrency=1"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hello-pangea/dnd": "18.0.1",
    "@mui/material": "9.3.1",
    "country-flag-icons": "1.6.20",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  }
}
