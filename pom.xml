<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>de.venomenon</groupId>
  <artifactId>csc-x-tool</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>CSC X Tool</name>

  <modules>
    <module>frontend</module>
    <module>backend</module>
  </modules>

  <properties>
    <revision>0.1.0</revision>
    <java.version>21</java.version>
    <frontend.maven.plugin.version>1.15.1</frontend.maven.plugin.version>
    <maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>
    <node.version>v24.20.0</node.version>
    <npm.version>12.0.2</npm.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <argLine>-Xms64m -Xmx768m -XX:ActiveProcessorCount=2</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
